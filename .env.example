# Public browser-safe Supabase settings.
# Copy this file to .env.local and fill in real values.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Prefer the newer publishable key:
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# If the Supabase project only exposes the older anon key,
# use this instead and remove/comment the line above:
# VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxx
